<%= simple_form_for [:admin, @event] do |form| %>
<div class="container">
  <div class="row mt-4">
    <div class="card">
      <div class="card-header">
        <h3 class="text-center font-weight-light my-4"><i class="bi bi-calendar2-event me-2"></i><% if @event.new_record? %> Novo Evento <% else %> Editar Evento <% end %></h3>
      </div>
      <div class="card-body">
          <div class="row">
            <div class="col-12 col-md-6">
              <%= form.input :name %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.input :status, collection: { 'Inscrições Abertas': 'registrations_open',
                                                    'Evento em andamento': 'event_in_progress',
                                                    'Evento encerrado': 'event_closed',
                                                    'Cancelado': 'cancelled' },
                                                    include_blank: false %>
            </div>
            <hr>
            <span><i class="bi bi-geo-alt me-2 "></i> Data e Local do Evento</span>
            <div class="col-12 col-md-6 mt-3">
              <%= form.input :period_start, html5: true %>
            </div>
            <div class="col-12 col-md-6 mt-3">
              <%= form.input :period_end, html5: true %>
            </div>
            <div class="col-12 col-md-12 mb-3">
              <%= form.input :local %>
            </div>
            <hr>
            <span><i class="bi bi-info-circle me-2 "></i> Informações do Evento</span>
            <div class="col-12 col-md-6 mt-3">
              <%= form.input :email %>
            </div>

            <div class="col-12 col-md-6 mt-3">
              <%= form.input :responsable %>
            </div>

            <div class="col-12 col-md-6">
              <%= form.input :banner %>
            </div>

            <div class="col-12 col-md-6 mb-3">
              <%= form.input :comission %>
            </div>


            <div class="col-12 col-md-12 mb-3" >
              <%= form.label :txtEnter %>
              <%= form.rich_text_area :txtEnter %>
            </div>
            
            <div class="col-12 col-md-12 mb-3">
              <%= form.label :txtAbout %>
              <%= form.rich_text_area :txtAbout %>
            </div>
            <hr>
            <span><i class="bi bi-gear me-2 "></i> Configurações do HotSite</span>
            <div class="col-12 col-md-6 mt-3">
              <%= form.input :primaryColor, as: :color %>
            </div>
            <div class="col-12 col-md-6 mt-3">
              <%= form.input :secondaryColor , as: :color %>
            </div>
          </div>
      </div>
      <div class="card-footer d-flex justify-content-around">
          <%= link_to 'voltar' , admin_events_path, class: 'btn btn-secondary' %>
          <%= form.button :button, class: 'btn btn-success' %>
        </div>
      </div>
    </div>
  </div>
  <% end %>