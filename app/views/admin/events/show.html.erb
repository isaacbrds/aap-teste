<div class="container">
   <div class="card mt-3">
      <div class="card-header">
        
      </div>
      <div class="card-body">
        <h3><%= @event.name %></h3>
        <span class="badge text-bg-secondary"><%= @event.status %></span>
      </div>
      <div class="card-footer">
        <%= @event.txtEnter %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <h4><i class="bi bi-calendar2-event me-2"></i> Data e Horário</h4>
        <p> Inicio: </p>
        <p><%= @event.period_start.strftime('%d/%m/%Y %H:%M') %></p>
        <p> Término: </p>
        <p><%= @event.period_end.nil? ? "Indefinido" : @event.period_end&.strftime('%d/%m/%Y %H:%M') %></p>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <h4><i class="bi bi-geo-alt me-2"></i> Localização </h4>
        <p><%= @event.local %></p>
      </div>
    </div>
    
    <div class="card mt-3">
      <div class="card-header d-flex justify-content-between">
        <h4><i class="bi bi-clock me-2"></i> Atividades do Evento </h4>
        <%= link_to new_admin_event_activity_path(@event), class: 'btn btn-success' do %>
          Nova Atividade <i class="bi bi-plus"></i>
        <% end %>
      </div>
      <div class="card-body">
        <ul class="list-unstyled">
          <% @event.activities.each do |activity| %>
            <div class="card mt-3">
              <div class="card-body">
                <h5 class="card-title mb-3"><%= activity.name %></h5>
                <h6 class="card-subtitle mt-3 text-muted mb-3"><i class="bi bi-person me-2"></i><%= activity.speaker %></h6>
                <p class="card-text"><i class="bi bi-clock me-2"></i><%= activity.period_start.strftime('%H:%M') %> - <%= activity.period_end.nil? ? "Indefinido" : activity.period_end&.strftime('%H:%M') %></p>
                <p class="card-text"><i class="bi bi-geo-alt me-2"></i><%= activity.local %></p>
                <p class="card-text"><%= link_to activity_presence_list_admin_event_activity_path(@event.id, activity), class: 'nav-link' do %>
                    <i class="bi bi-card-list me-2"></i> Participantes desta Atividade
                  <% end %></p>
              </div>
              <div class="card-footer">
                 <div class="d-flex justify-content-end">
                  <%= link_to admin_event_activity_path(@event.id, activity), class: 'btn btn-info me-2' do %>
                  <i class="bi bi-eye"></i>
                  <% end %>
                  <%= link_to edit_admin_event_activity_path(@event.id, activity), class: 'btn btn-warning  me-2'  do %>
                    <i class="bi bi-pencil-square"></i>
                  <% end %>
                  <%= link_to admin_event_activity_path(@event, activity)\
                        , data: { turbo_confirm: 'Você tem certeza?', turbo_method: :delete }\
                        , class: 'btn btn-danger' do %>
                        <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-info-circle me-2 mb-3"></i> Informações Adicionais </h4>
        <p class="mt-3"><i class="bi bi-person me-2"></i> Responsável: <strong><%= @event.responsable %></strong></p>
        <p><i class="bi bi-envelope me-2"></i> Email: <strong><%= @event.email %></strong></p>
        <p><%= @event.txtAbout %></p>
      </div>
    </div>
    <div class="col-12 mt-4">
      <%= link_to 'voltar' , admin_events_path, class: 'btn btn-secondary' %>
    </div>
</div>
