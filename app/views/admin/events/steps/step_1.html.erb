<%= render 'admin/events/steps/step_layout' do %>
  <h2 class="text-center font-weight-light my-4"> <i class="bi bi-info-circle me-2 "></i>  Informações Gerais do Evento</h2>
  <%= simple_form_for [:admin, @event], url: create_step_admin_events_path, method: :post, local: true,
  html: { class: "space-y-6" }, data: { step: 1 } do |form| %>
    <%= hidden_field_tag :step, 1 %>

    <div class="row">
      <div class="col-12 col-md-12 mb-4">
        <%= form.label :name, "Nome do Evento"  %>
        <%= form.text_field :name,
            class: "form-control",
            placeholder: "Ex: Workshop de Desenvolvimento Web" %>
        <% if @event.errors[:name].any? %>
          <p class="text-danger"><%= @event.errors[:name].first %></p>
        <% end %>
      </div>

      <!-- Período do Evento -->
        <div class="col-12 col-md-6 mb-4">
          <%= form.label :period_start, "Data de Início"  %>
          <%= form.date_field :period_start,
              class: "form-control" %>
          <% if @event.errors[:period_start].any? %>
            <p class="text-danger"><%= @event.errors[:period_start].first %></p>
          <% end %>
        </div>

        <div class="col-12 col-md-6 mb-4">
          <%= form.label :period_end, "Data de Término" %>
          <%= form.date_field :period_end,
              class: "form-control" %>
          <% if @event.errors[:period_end].any? %>
            <p class="text-danger"><%= @event.errors[:period_end].first %></p>
          <% end %>
        </div>
        <div class="col-12 col-md-12 mt-4 mb-4">
          <%= form.input :banner %>
        </div>
        <!-- Local -->
        <div class="col-12 col-md-12 mb-4">
          <%= form.label :local, "Local do Evento" %>
          <%= form.text_field :local,
          class: "form-control",
          placeholder: "Ex: Auditório Principal, Campus I" %>
          <% if @event.errors[:local].any? %>
            <p class="text-danger"><%= @event.errors[:local].first %></p>
          <% end %>
        </div>

        <div class="col-12 col-md-12 mb-3" >
          <%= form.label :txtEnter %>
          <%= form.rich_text_area :txtEnter %>
        </div>
            
        <div class="col-12 col-md-12 mb-3">
          <%= form.label :txtAbout %>
          <%= form.rich_text_area :txtAbout %>
        </div>

        <!-- Organizador -->
        <div class="col-12 col-md-6 mb-4">
          <%= form.label :responsable, "Responsável" %>
          <%= form.text_field :responsable,
          class: "form-control",
            placeholder: "Nome do responsável" %>
      </div>

      <div class="col-12 col-md-6 mb-4">
        <%= form.label :email, "Email de Contato" %>
        <%= form.email_field :email,
        class: "form-control",
        placeholder: "contato@campus.edu.br" %>
      </div>
      <!-- Comissão -->
      <div class="col-12 col-md-6 mb-4">
        <%= form.label :comission, "Comissão Organizadora" %>
        <%= form.text_field :comission,
        class: "form-control mt-2",
        placeholder: "Ex: Comissão de Extensão - Departamento de Computação" %>
      </div>

      <div class="col-12 col-md-6 mb-4">
        <%= form.input :status, collection: { 'Inscrições Abertas': 'registrations_open',
                                                    'Evento em andamento': 'event_in_progress',
                                                    'Evento encerrado': 'event_closed',
                                                    'Cancelado': 'cancelled' },
                                                    include_blank: false %>
      </div>

      <!-- Cores do Evento -->
      <h3 class="text-center font-weight-light my-4"><i class="bi bi-gear me-2 "></i>  Personalização Visual</h3>
      <div class="col-12 col-md-6 mb-4">
        <%= form.label :primaryColor, "Cor Primária" %>
        <%= form.color_field :primaryColor, value: @event.primaryColor || "#3B82F6",
        class: "form-control" %>
      </div>

      <div class="col-12 col-md-6 mb-4">
        <%= form.label :secondaryColor, "Cor Secundária" %>
        <%= form.color_field :secondaryColor, value: @event.secondaryColor || "#10B981",
        class: "form-control" %>
      </div>

      <!-- Botões -->
      <div class="d-flex justify-content-around items-center mt-6">
        <%= link_to "Cancelar", root_path, 
        class: "btn btn-danger" %>
        <%= link_to "Limpar Formulário", destroy_session_admin_events_path, method: :delete,
          confirm: "Tem certeza que deseja limpar todos os dados?",
          class: "btn btn-outline-danger" %>

          <%= form.submit "Próximo: Agenda", 
          class: "btn btn-success" %>
      </div>
    </div>
  <% end %>
<% end %>