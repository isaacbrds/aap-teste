<div class="container">
  <div class="row mt-4">
    <h1>Dashboard</h1>
    <h5 class="mb-4 mt-3">Visão geral dos seus eventos</h5>
    <div class="col-12 col-md-6 col-lg-3 mt-3">
        <div class="card card-custom">
          <div class="card-body">
              <div class="card-icon-bg bg-total-events"></div>
              <div class="d-flex justify-content-between align-items-start mb-3">
                  <div>
                      <p class="card-title-custom mb-0">Total de Eventos</p>
                      <h3 class="card-value"><%= @events.count %></h3>
                  </div>
                  <i class="bi bi-calendar-event fs-2 icon-total-events"></i>
              </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 mt-3">
          <div class="card card-custom">
              <div class="card-body">
                  <div class="card-icon-bg bg-active-events"></div>
                  <div class="d-flex justify-content-between align-items-start mb-3">
                      <div>
                          <p class="card-title-custom mb-0">Eventos Ativos</p>
                          <h3 class="card-value"><%= @events.registrations_open.count %></h3>
                      </div>
                      <i class="bi bi-graph-up fs-2 icon-active-events"></i>
                  </div>
              </div>
          </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 mt-3">
          <div class="card card-custom">
              <div class="card-body">
                  <div class="card-icon-bg bg-total-participants"></div>
                  <div class="d-flex justify-content-between align-items-start mb-3">
                      <div>
                          <p class="card-title-custom mb-0">Total de Participantes</p>
                          <h3 class="card-value"><%= @events.registrations_open.count %></h3>
                      </div>
                      <i class="bi bi-people fs-2 icon-total-participants"></i>
                  </div>
              </div>
          </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 mt-3">
          <div class="card card-custom">
              <div class="card-body">
                  <div class="card-icon-bg bg-upcoming-events"></div>
                  <div class="d-flex justify-content-between align-items-start mb-3">
                      <div>
                          <p class="card-title-custom mb-0">Próximos Eventos</p>
                          <h3 class="card-value">0</h3>
                      </div>
                      <i class="bi bi-clock fs-2 icon-upcoming-events"></i>
                  </div>
              </div>
          </div>
      </div>
  </div>
</div>
