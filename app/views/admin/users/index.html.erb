<div class="container">
  <div class="row mt-4">
    <div class="d-flex justify-content-between">
    <h2 class="mb-2 mt-3">Usuários</h2>
    <span class="mb-2 mt-3">
      <%= link_to new_admin_user_path, class: "btn btn-primary" do %>
          Criar Usuário<i class="bi bi-plus-square ms-2"></i>
      <% end %>
    </span>
  </div>
    <% @users.each do |user| %>
      <div class="card mb-2">
        <div class="card-header"></div>
        <div class="card-body">
          <h5 class="card-title mb-3"><i class="bi bi-person"></i> <%= user.email %></h5>
          <p class="card-text"><i class="bi bi-person-vcard-fill me-1"></i>
            <%= I18n.t("activerecord.attributes.user.roles.#{user.role}") %>
          </p>
        </div>
        <div class="card-footer d-flex justify-content-end mb-3">
          
                <%= link_to admin_user_path(user), class: 'btn btn-info btn-sm me-2' do %>
                    <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_user_path(user), class: 'btn btn-warning btn-sm me-2' do %>
                      <i class="bi bi-pencil-square"></i>
                    <% end %>
                    <%= link_to admin_user_path(user), data: { turbo_confirm: 'Tem certeza?', turbo_method: :delete }, class: 'btn btn-danger btn-sm' do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
          
        </div>
      </div>
    <% end %>
    <div class="d-flex justify-content-center">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  </div>
</div>