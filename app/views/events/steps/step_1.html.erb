<!-- app/views/events/steps/step_1.html.erb -->
<%= render 'step_layout' do %>
  <h2 class="text-2xl font-bold mb-6 text-gray-800">Informações Gerais do Evento</h2>

  <%= form_with model: @event, url: create_step_events_path, method: :post, local: true, 
                html: { class: "space-y-6" }, data: { step: 1 } do |form| %>
    <%= hidden_field_tag :step, 1 %>

    <!-- Nome do Evento -->
    <div>
      <%= form.label :name, "Nome do Evento", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, 
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
          placeholder: "Ex: Workshop de Desenvolvimento Web" %>
      <% if @event.errors[:name].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @event.errors[:name].first %></p>
      <% end %>
    </div>

    <!-- Descrição -->
    <div>
      <%= form.label :description, "Descrição", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :description, rows: 4,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
          placeholder: "Descreva o evento, objetivos e público-alvo..." %>
    </div>

    <!-- Período do Evento -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :period_start, "Data de Início", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :period_start,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        <% if @event.errors[:period_start].any? %>
          <p class="mt-1 text-sm text-red-600"><%= @event.errors[:period_start].first %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :period_end, "Data de Término", class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :period_end,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        <% if @event.errors[:period_end].any? %>
          <p class="mt-1 text-sm text-red-600"><%= @event.errors[:period_end].first %></p>
        <% end %>
      </div>
    </div>

    <!-- Local -->
    <div>
      <%= form.label :local, "Local do Evento", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :local,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
          placeholder: "Ex: Auditório Principal, Campus I" %>
    </div>

    <!-- Organizador -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :responsable, "Responsável", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :responsable,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
            placeholder: "Nome do responsável" %>
      </div>

      <div>
        <%= form.label :email, "Email de Contato", class: "block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
            placeholder: "contato@campus.edu.br" %>
      </div>
    </div>

    <!-- Comissão -->
    <div>
      <%= form.label :comission, "Comissão Organizadora", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :comission,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
          placeholder: "Ex: Comissão de Extensão - Departamento de Computação" %>
    </div>

    <!-- Cores do Evento -->
    <div>
      <h3 class="text-lg font-medium text-gray-800 mb-3">Personalização Visual</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :primaryColor, "Cor Primária", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex items-center space-x-2">
            <%= form.color_field :primaryColor, value: @event.primaryColor || "#3B82F6",
                class: "h-10 w-20 rounded border border-gray-300" %>
            <%= form.text_field :primaryColor, value: @event.primaryColor || "#3B82F6",
                class: "flex-1 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          </div>
        </div>

        <div>
          <%= form.label :secondaryColor, "Cor Secundária", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex items-center space-x-2">
            <%= form.color_field :secondaryColor, value: @event.secondaryColor || "#10B981",
                class: "h-10 w-20 rounded border border-gray-300" %>
            <%= form.text_field :secondaryColor, value: @event.secondaryColor || "#10B981",
                class: "flex-1 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Botões -->
    <div class="flex justify-between pt-6">
      <%= link_to "Cancelar", root_path, 
          class: "px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
      
      <div class="space-x-3">
        <%= link_to "Limpar Formulário", destroy_session_events_path, method: :delete,
            confirm: "Tem certeza que deseja limpar todos os dados?",
            class: "px-4 py-2 text-red-600 hover:text-red-800" %>
        
        <%= form.submit "Próximo: Agenda", 
            class: "px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </div>
  <% end %>
<% end %>
